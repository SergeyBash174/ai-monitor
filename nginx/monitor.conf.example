# Страница-монитор ai-monitor (Strata-style) — статика + прокси только к Prometheus API
server {
    listen 80;
    server_name monitor.example.com;   # ← твой домен/имя

    # ← впиши свои подсети, из которым можно смотреть монитор
    allow 192.168.1.0/24;               # LAN
    allow 100.64.0.0/10;                # Tailscale (если используешь)
    allow 127.0.0.1;
    allow ::1;
    deny all;

    # только read-API Prometheus (подстановки в дашборде)
    location /api/v1/ {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    root /opt/ai-monitor/web;   # ← путь, где лежит репозиторий на сервере
    location / {
        try_files $uri $uri/ /index.html;
    }
}
