# Мониторинг LLM: Grafana + Prometheus через reverse proxy
# Порт 80; allow-list ограничивает доступ по подсетям.
server {
    listen 80;
    server_name grafana.example.com;

    allow 192.168.1.0/24;               # LAN
    allow 10.0.0.0/24;                # вторая подсеть (по необходимости)
    allow 100.64.0.0/10;                # Tailscale
    allow 127.0.0.1;
    allow ::1;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Grafana live / websockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name prometheus.example.com;

    allow 192.168.1.0/24;
    allow 10.0.0.0/24;                # вторая подсеть (по необходимости)
    allow 100.64.0.0/10;
    allow 127.0.0.1;
    allow ::1;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
