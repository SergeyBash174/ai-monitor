# Copy to .env and fill in real values (deploy target: docker compose)
PROM_IMAGE_TAG=v3.15.1
GRAFANA_IMAGE_TAG=12.4.3

# Grafana: bind address + external URL behind your reverse proxy
GRAFANA_LISTEN_ADDR=127.0.0.1
GRAFANA_LISTEN_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001/

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Bearer token for scraping LiteLLM /metrics (write it also to prometheus/secrets/litellm_key)
# LITELLM_TOKEN=...

# NOTE: page-level personalization (title, subtitle, API base) lives in
# web/config.js — copy web/config.example.js to web/config.js
# nginx vhosts: copy nginx/*.conf.example to nginx/*.conf and edit
# subnets/hostnames there. .conf / config.js are gitignored on purpose.
